# Night Shift API (VM). Never commit the filled-in copy (deploy/api.env is gitignored).
LITELLM_API_KEY=
LITELLM_BASE_URL=https://litellm.vision.aivar.app/v1
NEATLOGS_API_KEY=            # for the public Harbor sandbox only; tenants bring their own
HARBOR_BRAIN=live
# auth: share NS_AUTH_SECRET and NS_INTERNAL_SECRET with the web app (Vercel)
NS_AUTH_SECRET=              # openssl rand -hex 32
NS_INTERNAL_SECRET=          # openssl rand -hex 32
NS_ENCRYPTION_KEY=           # python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
CORS_ORIGINS=https://<your-app>.vercel.app
PUBLIC_WEB_URL=https://<your-app>.vercel.app
PUBLIC_BASE_URL=https://<your-app>.vercel.app
# PUBLIC_API_URL is added automatically (https://api.<ip>.sslip.io)
# Slack app (see deploy/slack-manifest.yml)
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=
