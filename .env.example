# LLM gateway (OpenAI-compatible LiteLLM proxy)
LITELLM_API_KEY=
LITELLM_BASE_URL=https://litellm.vision.aivar.app/v1

# neatlogs project API key (SDK ingest + MCP read-back)
NEATLOGS_API_KEY=

# Harbor brain: live (LLM) or sim (deterministic, offline)
HARBOR_BRAIN=live
HARBOR_MODEL=claude-haiku
HARBOR_FALLBACK_MODEL=nova-lite
NIGHTSHIFT_MODEL=claude-sonnet-4.6

# Paging (ntfy.sh topic; pick something unguessable)
NTFY_TOPIC=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Dashboard
PUBLIC_BASE_URL=http://localhost:3000
